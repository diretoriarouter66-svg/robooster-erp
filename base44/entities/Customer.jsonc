{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome / Raz\u00e3o Social"
    },
    "trade_name": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "person_type": {
      "type": "string",
      "enum": [
        "PF",
        "PJ"
      ],
      "default": "PF"
    },
    "document": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "state_registration": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp"
    },
    "zip_code": {
      "type": "string",
      "description": "CEP"
    },
    "state": {
      "type": "string",
      "description": "UF"
    },
    "city": {
      "type": "string",
      "description": "Cidade"
    },
    "neighborhood": {
      "type": "string",
      "description": "Bairro"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o"
    },
    "address_number": {
      "type": "string",
      "description": "N\u00famero"
    },
    "address_complement": {
      "type": "string",
      "description": "Complemento"
    },
    "channel": {
      "type": "string",
      "enum": [
        "direct",
        "mercado_livre",
        "woocommerce",
        "other"
      ],
      "default": "direct"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name"
  ]
}