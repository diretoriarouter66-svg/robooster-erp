{
  "name": "Product",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "description": "C\u00f3digo SKU interno"
    },
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "brand": {
      "type": "string",
      "description": "Marca"
    },
    "category_id": {
      "type": "string",
      "description": "ID da categoria"
    },
    "category_name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "ncm": {
      "type": "string",
      "description": "NCM - Nomenclatura Comum do Mercosul"
    },
    "origin_country": {
      "type": "string",
      "description": "Pa\u00eds de origem"
    },
    "unit": {
      "type": "string",
      "enum": [
        "UN",
        "KG",
        "CX",
        "PC",
        "MT",
        "LT",
        "PAR"
      ],
      "default": "UN"
    },
    "weight_kg": {
      "type": "number",
      "description": "Peso em KG"
    },
    "height_cm": {
      "type": "number",
      "description": "Altura em CM"
    },
    "width_cm": {
      "type": "number",
      "description": "Largura em CM"
    },
    "length_cm": {
      "type": "number",
      "description": "Comprimento em CM"
    },
    "cost_fob_usd": {
      "type": "number",
      "description": "Custo FOB em USD"
    },
    "cost_landed_brl": {
      "type": "number",
      "description": "Custo landed em BRL (calculado)"
    },
    "sale_price": {
      "type": "number",
      "description": "Pre\u00e7o de venda em BRL"
    },
    "markup_percent": {
      "type": "number",
      "description": "Markup percentual"
    },
    "ii_rate": {
      "type": "number",
      "description": "Al\u00edquota II (%)"
    },
    "ipi_rate": {
      "type": "number",
      "description": "Al\u00edquota IPI (%)"
    },
    "pis_rate": {
      "type": "number",
      "description": "Al\u00edquota PIS (%)",
      "default": 2.1
    },
    "cofins_rate": {
      "type": "number",
      "description": "Al\u00edquota COFINS (%)",
      "default": 9.65
    },
    "icms_rate": {
      "type": "number",
      "description": "Al\u00edquota ICMS (%)"
    },
    "stock_quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em estoque"
    },
    "min_stock": {
      "type": "number",
      "default": 0,
      "description": "Estoque m\u00ednimo"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem principal"
    },
    "images": {
      "type": "array",
      "description": "URLs de imagens adicionais",
      "items": {
        "type": "string"
      }
    },
    "video_url": {
      "type": "string",
      "description": "Link externo de v\u00eddeo"
    },
    "barcode": {
      "type": "string",
      "description": "C\u00f3digo de barras EAN/GTIN"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "discontinued"
      ],
      "default": "active"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID do fornecedor principal"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name",
    "sku"
  ]
}