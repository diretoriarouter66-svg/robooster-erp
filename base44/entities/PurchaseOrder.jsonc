{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "N\u00famero da PO"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID do fornecedor"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nome do fornecedor"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "confirmed",
        "partial",
        "received",
        "cancelled"
      ],
      "default": "draft"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "CNY",
        "BRL"
      ],
      "default": "USD"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Cota\u00e7\u00e3o utilizada"
    },
    "items": {
      "type": "array",
      "description": "Itens da PO (JSON)",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal na moeda original"
    },
    "total_brl": {
      "type": "number",
      "description": "Total em BRL"
    },
    "payment_terms": {
      "type": "string",
      "description": "Condi\u00e7\u00f5es de pagamento"
    },
    "expected_delivery": {
      "type": "string",
      "format": "date",
      "description": "Previs\u00e3o de entrega"
    },
    "import_process_id": {
      "type": "string",
      "description": "ID do processo de importa\u00e7\u00e3o vinculado"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "supplier_name"
  ]
}