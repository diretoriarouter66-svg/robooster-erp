{
  "name": "SaleOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero do pedido"
    },
    "customer_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "channel": {
      "type": "string",
      "enum": [
        "direct",
        "mercado_livre",
        "woocommerce",
        "other"
      ],
      "default": "direct"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "invoiced",
        "shipped",
        "delivered",
        "cancelled",
        "returned"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "description": "Itens do pedido (JSON)",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Desconto"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Frete"
    },
    "total": {
      "type": "number",
      "description": "Total do pedido"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "boleto",
        "credit_card",
        "transfer",
        "marketplace"
      ],
      "default": "pix"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "partial",
        "refunded"
      ],
      "default": "pending"
    },
    "tracking_code": {
      "type": "string",
      "description": "C\u00f3digo de rastreamento"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero da NF"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "customer_name"
  ]
}