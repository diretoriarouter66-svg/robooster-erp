{
  "name": "SaleOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Número do pedido"
    },
    "customer_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "channel": {
      "type": "string",
      "enum": [
        "direct",
        "mercado_livre",
        "woocommerce",
        "other"
      ],
      "default": "direct"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "invoiced",
        "shipped",
        "delivered",
        "cancelled",
        "returned"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "description": "Itens do pedido (JSON)",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Desconto"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Frete"
    },
    "total": {
      "type": "number",
      "description": "Total do pedido"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "boleto",
        "credit_card",
        "transfer",
        "marketplace"
      ],
      "default": "pix"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "partial",
        "refunded"
      ],
      "default": "pending"
    },
    "tracking_code": {
      "type": "string",
      "description": "Código de rastreamento"
    },
    "invoice_number": {
      "type": "string",
      "description": "Número da NF"
    },
    "notes": {
      "type": "string",
      "description": "Observações"
    },
    "installments": {
      "type": "number",
      "default": 1,
      "description": "Número de parcelas"
    },
    "installment_interval_days": {
      "type": "number",
      "default": 30,
      "description": "Intervalo entre parcelas (dias)"
    },
    "first_due_days": {
      "type": "number",
      "default": 0,
      "description": "Dias até o 1º vencimento"
    },
    "financial_entry_id": {
      "type": "string",
      "description": "ID da conta a receber principal (legado)"
    },
    "stock_deducted": {
      "type": "boolean",
      "default": false,
      "description": "Estoque baixado (legado; a verdade é o Kardex)"
    }
  },
  "required": [
    "customer_name"
  ]
}