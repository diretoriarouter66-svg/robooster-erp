{
  "name": "ImportOperation",
  "properties": {
    "cambio": {
      "description": "Câmbio USD/BRL da operação",
      "type": "number"
    },
    "comissao_perc": {
      "default": 0,
      "description": "Comissão de venda (%)",
      "type": "number"
    },
    "container_tipo": {
      "description": "Tipo de container (20ft, 40ft, 40HC, LCL)",
      "type": "string"
    },
    "data": {
      "format": "date",
      "type": "string"
    },
    "despesas_locais_usd": {
      "description": "Despesas locais de importação em USD",
      "type": "number"
    },
    "frete_container_usd": {
      "default": 0,
      "description": "Frete do container em USD",
      "type": "number"
    },
    "frete_internacional_usd": {
      "type": "number"
    },
    "itens": {
      "description": "Mix de produtos: cada item referencia product_id do cadastro unificado + quantidade",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "nome": {
      "type": "string"
    },
    "prazo_venda_meses": {
      "default": 3,
      "description": "Prazo estimado para vender o lote (meses)",
      "type": "number"
    },
    "purchase_order_id": {
      "description": "ID da PO vinculada (quando a simulação vira compra real)",
      "type": "string"
    },
    "resultado_cubagem": {
      "description": "Resultado calculado da cubagem do container",
      "type": "object"
    },
    "resultado_importacao": {
      "description": "Resultado calculado: custo landed por produto",
      "type": "object"
    },
    "resultado_venda": {
      "description": "Resultado calculado do cenário de venda",
      "type": "object"
    },
    "seguro_usd": {
      "default": 0,
      "type": "number"
    },
    "status": {
      "default": "simulacao",
      "enum": [
        "simulacao",
        "aprovada",
        "em_transito",
        "realizada"
      ],
      "type": "string"
    },
    "tipo_venda": {
      "default": "interna",
      "enum": [
        "interna",
        "interestadual",
        "mista"
      ],
      "type": "string"
    },
    "vendas": {
      "description": "Cenário de vendas: preços e quantidades por produto",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "pct_declarado": {
      "type": "number",
      "default": 100,
      "description": "Percentual do valor real declarado na invoice (%)"
    },
    "remessas": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Remessas de pagamento ao fornecedor: data, valor_usd, cotacao, taxas_brl"
    },
    "estoque_lancado": {
      "type": "boolean",
      "default": false,
      "description": "Entrada de estoque já lançada (legado; a verdade é o Kardex)"
    }
  },
  "required": [
    "nome"
  ],
  "type": "object"
}