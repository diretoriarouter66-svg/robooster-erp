{
  "name": "SalesChannel",
  "properties": {
    "name": {
      "description": "Nome do canal (ex: Venda Direta, ML Clássico, ML Premium, Site)",
      "type": "string"
    },
    "type": {
      "enum": [
        "venda_direta",
        "mercado_livre_classico",
        "mercado_livre_premium",
        "site_woocommerce",
        "amazon",
        "outro"
      ],
      "type": "string"
    },
    "commission_percent": {
      "default": 0,
      "description": "Comissão do canal (%)",
      "type": "number"
    },
    "fixed_fee": {
      "default": 0,
      "description": "Taxa fixa por venda (R$)",
      "type": "number"
    },
    "is_master": {
      "type": "boolean",
      "default": false,
      "description": "Canal master da precificação"
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "dias_liberacao": {
      "type": "number",
      "default": 0,
      "description": "Dias até a liberação do dinheiro (ex: Mercado Livre ~14)"
    },
    "aliq_icms_venda": {
      "type": "number",
      "description": "Alíquota efetiva de ICMS de saída deste canal (%) — ex: 8,8 SP interno com Conv. 52/91; 4 interestadual contribuinte. Vazio = usa a do produto"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "type": "object"
}